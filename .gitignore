# Only functional code and essential documentation are published.
# Research working documents (questionnaire drafts, specs, taxonomies, papers, notes) stay local.
/*.md
!/README.md
!/AGENTS.md
/*.pdf
/*.doc
/*.docx
/*.txt

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.tsbuildinfo
.vite/
coverage/

# Environment files (only the template is tracked)
.env
.env.*
!.env.example

# Deployment tooling
.vercel/
.clasp.json
.clasprc.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and local agent settings
.claude/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini
